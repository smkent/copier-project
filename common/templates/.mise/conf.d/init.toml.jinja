[tasks.init]
description = "Initialize git repository once on project creation"
run = [
  '[ ! -d .git ] || { echo "git repository already exists"; exit 1; }',
  "git init",
  "mise install",
{%- if project_visibility == 'public' %}
  "git remote add origin https://github.com/{{ github_user }}/{{ project_name }}",
  "git config --local url.\"git@github.com:\".pushInsteadOf \"https://github.com/\"",
{%- endif %}
  "git add .",
  "git rm -f .mise/conf.d/init.toml",
  "git commit -m 'Create project from template'",
]
