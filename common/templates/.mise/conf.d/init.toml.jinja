[tasks.init]
description = "Initialize git repository once on project creation"
run = [
  "git init",
  "mise install",
{%- if project_visibility == 'public' %}
  "git remote get-url origin >/dev/null 2>&1 || git remote add origin https://github.com/{{ github_user }}/{{ project_name }}",
{%- endif %}
  '[ -z "$(git rev-list -n 1 --all)" ] || { echo "git repository already contains commits"; exit 1; }',
  "git add . -- :!.mise/conf.d/init.toml",
  "git commit -m 'Create project from template'",
  "git clean -dxf -- .mise/",
]
