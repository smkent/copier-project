{% extends "common/templates/workflows/base.jinja" %}
{% import "common/github-workflow-steps.jinja" as wf with context %}

{% block name -%}
CI
{%- endblock %}

{% block triggers %}
push:
  branches:
    - main
pull_request:
{% endblock %}

{% block jobs %}
{% if enable_docs -%}
docs:
  name: Documentation
  runs-on: ubuntu-latest
  timeout-minutes: 15
  steps:
    {{ wf.step_checkout(full_history=true) | indent(4) }}

    {{ wf.steps_project_setup() | indent(4) }}

    {{ wf.step_docs_build() | indent(4) }}

{% endif -%}
betterleaks:
  name: Secret scan
  runs-on: ubuntu-latest
  timeout-minutes: 15
  steps:
    {{ wf.step_checkout(full_history=true) | indent(4) }}

    {{ wf.steps_project_setup() | indent(4) }}

    - name: 🔍 Check for secrets
      run: mise run secretscan
{%- if enable_commit_check %}

commit-messages:
  name: Commit messages
  if: {% raw %}${{ github.event_name == 'pull_request' }}{% endraw %}
  runs-on: ubuntu-latest
  timeout-minutes: 15
  steps:
    {{ wf.step_checkout(full_history=true) | indent(4) }}

    - name: ✉️ Check commit messages
      uses: commit-check/commit-check-action@v2
      with:
        branch: false
{%- endif %}
{% endblock %}
