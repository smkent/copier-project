{%- set base_match_managers = ["github-actions", "mise", "pre-commit"] -%}
{%- set current_match_managers = base_match_managers + match_managers | default([]) -%}
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:weekly"],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "matchManagers": {{ current_match_managers | unique | sort | tojson }},
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major dependencies"
    }
  ]
}
