{%- import "common/blocks.jinja" as blocks -%}

min_version = "2026.2.5"

[hooks]
postinstall = [
{%- set postinstall_hooks %}{% block postinstall_hooks %}{% endblock %}{% endset -%}
{{- blocks.put(postinstall_hooks, indent=2) }}
  "[ -e .git ] && prek --quiet install || { echo \"No git repository found.\"; }",
]

[tools]
betterleaks = "latest"
jactionlint = "latest"
{%- block check_tool %}
{%- if enable_commit_check %}
"pipx:commit-check" = "latest"
{%- endif %}
{%- endblock %}
"pipx:copier" = "latest"
prek = "latest"
taplo = "latest"
uv = "latest"

{%- set tasks_start %}{% block tasks_start %}{% endblock %}{% endset -%}
{{- blocks.put(tasks_start, blank_lines=1) }}

[tasks.lint]
description = "Run all formatters and static checks"
raw_args = true
run = "prek run --all-files"

[tasks.lt]
description = "Run all formatters, static checks, and tests"
run = [{ task = "lint" }, { task = "test" }]

{%- set tasks_after_lt %}{% block tasks_after_lt %}{% endblock %}{% endset -%}
{{- blocks.put(tasks_after_lt, blank_lines=1) }}

[tasks.secretscan]
description = "Scan git history for secrets"
raw_args = true
run = "betterleaks git . --redact"

{%- set tasks_after_secretscan %}{% block tasks_after_secretscan %}{% endblock %}{% endset -%}
{{- blocks.put(tasks_after_secretscan, blank_lines=1) }}

[tasks.test]
description = "Run tests"
raw_args = true
run = "{%- set tasks_test_run %}{% block tasks_test_run %}echo \"No test command defined. Set the \\`test\\` command in mise.toml -> [tasks.test] -> \\`run\\`.\"{% endblock %}{% endset -%}{{- tasks_test_run | trim -}}"

{%- set tasks_after_test %}{% block tasks_after_test %}{% endblock %}{% endset -%}
{{- blocks.put(tasks_after_test, blank_lines=1) }}
