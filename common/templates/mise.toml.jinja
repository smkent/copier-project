{%- import "common/blocks.jinja" as blocks -%}

min_version = "2026.2.5"

[hooks]
postinstall = [
{%- set postinstall_hooks %}{% block postinstall_hooks %}{% endblock %}{% endset -%}
{{- blocks.put(postinstall_hooks, indent=2) }}
  "[ -e .git ] && prek --quiet install || { echo \"No git repository found. If this is a new project, run \\`mise run init\\` to create it.\"; }",
]

[tools]
betterleaks = "latest"
jactionlint = "latest"
{%- block check_tool %}
{%- if enable_commit_check %}
"pipx:commit-check" = "latest"
{%- endif %}
{%- endblock %}
"pipx:copier" = "latest"
prek = "latest"
taplo = "latest"
uv = "latest"

{%- set tasks_start %}{% block tasks_start %}{% endblock %}{% endset -%}
{{- blocks.put(tasks_start, blank_lines=1) }}

[tasks.init]
description = "Initialize git repository once on project creation"
run = [
  '[ ! -d .git ] || { echo "git repository already exists"; exit 1; }',
  "git init",
  "mise install",
{%- if project_visibility == 'public' %}
  "git remote add origin https://github.com/{{ github_user }}/{{ project_name }}",
  "git config --local remote.origin.pushurl git@github.com:{{ github_user }}/{{ project_name }}.git",
{%- endif %}
  "git add .",
  "git commit -m 'Create project from template'",
]

[tasks.lint]
description = "Run all formatters and static checks"
raw_args = true
run = "prek run --all-files"

{%- set task_lt %}{% block task_lt %}
[tasks.lt]
description = "Run all formatters and static checks (same as lint)"
run = [{ task = "lint" }]
{% endblock %}{% endset -%}
{{- blocks.put(task_lt, blank_lines=1) }}

{%- set tasks_after_lt %}{% block tasks_after_lt %}{% endblock %}{% endset -%}
{{- blocks.put(tasks_after_lt, blank_lines=1) }}

[tasks.secretscan]
description = "Scan git history for secrets"
raw_args = true
run = "betterleaks git . --redact"

{%- set tasks_after_secretscan %}{% block tasks_after_secretscan %}{% endblock %}{% endset -%}
{{- blocks.put(tasks_after_secretscan, blank_lines=1) }}
