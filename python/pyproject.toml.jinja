{%- import "common/license.jinja" as license with context -%}
{%- import "common/python.jinja" as py with context -%}

{%- set tool_uv_dependency_groups = {
    "dev": [
        "bump-my-version>=1.3.0",
        "pytest>=9,<9.2",
        "pytest-cov>=7",
        "pytest-sugar>=1",
        "ruff>=0.17",
        "ty>=0.0.84",
    ]
} -%}
{%- set tool_uv_default_groups = ["dev"] -%}

{%- if project_visibility == "public" -%}
{%- set _ = tool_uv_dependency_groups['dev'].append("pysentry-rs>=0.5") -%}
{%- endif -%}

{%- if enable_commit_check -%}
{%- set _ = tool_uv_dependency_groups['dev'].append("commit-check>=2.18") -%}
{%- endif -%}

{%- if "syrupy" in enable_features -%}
{%- set _ = tool_uv_dependency_groups['dev'].append("syrupy>=5") -%}
{%- endif -%}

{%- if "xdist" in enable_features -%}
{%- set _ = tool_uv_dependency_groups['dev'].append("pytest-xdist>=3") -%}
{%- endif -%}

{%- if enable_docs -%}
{%- set _ = tool_uv_dependency_groups.update({
    "docs": [
        "mkdocstrings[python]>=1",
        "zensical>=0.1",
    ]
}) -%}
{%- set _ = tool_uv_default_groups.append("docs") -%}
{%- endif -%}

[build-system]
requires = ["hatchling", "uv-dynamic-versioning"]
build-backend = "hatchling.build"

[project]
name = "{{ project_name }}"
dynamic = ["version"]
description = "{{ project_description }}"
readme = "README.md"
license = "{{ copyright_license }}"
license-files = ["{{ license.files | join('", "') }}"]
requires-python = "{{ py.requires_python() }}"
authors = [{ name = "{{ user_name }}", email = "{{ user_email }}" }]
classifiers = [
  "Development Status :: 3 - Alpha",
  "Intended Audience :: Developers",
  "Programming Language :: Python :: 3",
  "Programming Language :: Python :: 3 :: Only",
{%- call(loop, v) py.for_each_version() %}
  "Programming Language :: Python :: {{ v }}",
{%- endcall %}
  "Topic :: Documentation",
  "Topic :: Software Development",
  "Topic :: Utilities",
  "Typing :: Typed",
]
keywords = []
dependencies = []
{%- if project_type == 'application' %}

[project.scripts]
"{{ project_name }}" = "{{ project_slug }}.__main__:main"
{%- endif %}
{%- if project_visibility == 'public' %}

[project.urls]
{%- set homepage_url = (
    "https://" + github_user + ".github.io/" + project_name
    if enable_docs else
    "https://github.com/" + github_user + "/" + project_name
) %}
Homepage = "{{ homepage_url }}"
Repository = "https://github.com/{{ github_user }}/{{ project_name }}"
Issues = "https://github.com/{{ github_user }}/{{ project_name }}/issues"
{%- endif %}

[dependency-groups]
dev = [
{%- for dep in tool_uv_dependency_groups["dev"] | sort %}
  "{{ dep }}",
{%- endfor %}
]
{%- if "docs" in tool_uv_dependency_groups %}
docs = ["{{ tool_uv_dependency_groups['docs'] | sort | join('\", \"') }}"]
{%- endif %}

[tool.bumpversion]
commit = false
tag = true
tag_name = "v{new_version}"
tag_message = ""
push = true

[tool.hatch.build.targets.sdist]
include = ["/{{ project_slug }}", "/tests", "*.md", "{{ license.files | join('", "') }}"]

[tool.hatch.build.targets.wheel]
packages = ["{{ project_slug }}"]

[tool.hatch.version]
source = "uv-dynamic-versioning"

[tool.pytest]
addopts = [
  "-ra",
  "--cov={{ project_slug }}",
  "--strict-config",
  "--strict-markers",
{%- if "xdist" in enable_features %}
  "--numprocesses",
  "auto",
{%- endif %}
]
testpaths = ["tests"]

[tool.coverage.run]
source = ["{{ project_slug }}"]
branch = true

[tool.coverage.report]
show_missing = true
skip_covered = true
exclude_lines = ["pragma: no cover", "if TYPE_CHECKING:", "@abstractmethod"]

[tool.ruff]
line-length = 79
output-format = "concise"
target-version = "py{{ python_version_minimum | replace('.', '') }}"

[tool.ruff.lint]
select = ["ALL"]
ignore = [
  "ANN401", # Dynamically typed expressions (typing.Any) are disallowed
  "COM812", # Trailing comma missing
  "CPY001", # Missing copyright notice at top of file
  "D1",     # Missing docstring presence rules
  "EM",     # flake8-errmsg
  "G004",   # Logging statement uses f-string
  "PLR",    # pylint Refactor
  "S607",   # Starting a process with a partial executable path
  "TD",     # flake8-todos
  "TRY003", # Avoid specifying long messages outside the exception class
]

[tool.ruff.lint.isort]
known-first-party = ["{{ project_slug }}"]

[tool.ruff.lint.per-file-ignores]
"tests/**/*.py" = [
  "ARG",  # flake8-unused-arguments
  "S101", # Use of assert detected
]

[tool.ruff.lint.pydocstyle]
convention = "google"

[tool.ty.src]
include = ["{{ project_slug }}/", "tests/"]

[tool.ty.terminal]
error-on-warning = true
output-format = "concise"

[tool.uv]
cache-keys = [
  { file = "pyproject.toml" },
  { git = { commit = true, tags = true } },
]
default-groups = ["{{ tool_uv_default_groups | sort | join('\", \"') }}"]

[tool.uv-dynamic-versioning]
pattern = "default-unprefixed"
fallback-version = "0.0.0"
{#- vim: set ft=toml: #}
