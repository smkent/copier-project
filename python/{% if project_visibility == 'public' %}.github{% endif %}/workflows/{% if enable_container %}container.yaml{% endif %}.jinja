{% extends "common/templates/workflows/container.yaml.jinja" %}
{% import "common/github-workflow-steps.jinja" as wf with context %}

{% block image_needs %}
needs: version
{% endblock %}

{% block image_builder_args %}
build-args: |
  UV_DYNAMIC_VERSIONING_BYPASS={% raw %}${{ needs.version.outputs.version }}{% endraw %}
{% endblock %}

{% block jobs %}
version:
  name: Version
  runs-on: ubuntu-latest
  timeout-minutes: 5
  outputs:
    version: {% raw %}${{ steps.version.outputs.version }}{% endraw %}
  steps:
    {{ wf.step_checkout(full_history=true) | indent(4) }}

    - name: 🏷️ Determine project version
      id: version
      run: |
        pip install --quiet uv
        version="$(uvx{% if dependency_cooldown %} --exclude-newer={{ dependency_cooldown }}{% endif %} uv-dynamic-versioning)"
        echo "version=${version}" >> "${GITHUB_OUTPUT}"
        echo "::notice title=Project version::${version}"
{{ super() }}
{% endblock %}
