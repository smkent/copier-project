{% extends "common/templates/ci.yaml.jinja" %}
{% import "common/github-workflow-steps.jinja" as ci with context %}
{% import "common/python.jinja" as py with context %}

{% block env %}
UV_PYTHON: '{{ py.latest() }}'
{% endblock %}

{% block jobs %}
ci:
  name: {% raw %}Test (Python ${{ matrix.python-version }}){% endraw %}
  runs-on: ubuntu-latest
  timeout-minutes: 15
  env:
    UV_PYTHON: {% raw %}${{ matrix.python-version }}{% endraw %}
  strategy:
    fail-fast: false
    matrix:
      python-version:
{%- call(loop, v) py.for_each_version() %}
        - '{{ v }}'
{%- endcall %}
  steps:
    {{ ci.step_checkout() | indent(4) }}

    {{ ci.steps_project_setup(cache_key_suffix="${{ matrix.python-version }}-") | indent(4) }}

    - name: 📐 Lint
      run: mise run lint

    - name: 🔥 Test
      run: mise run test
{%- if enable_coverage %}

    - name: 🔍 Collect coverage results
      run: uv run coverage xml
      if: {% raw %}${{ matrix.python-version == '{% endraw %}{{ py.latest() }}{% raw %}' }}{% endraw %}

    - name: 📊 Upload coverage to Codecov
      uses: codecov/codecov-action@v7
      if: {% raw %}${{ matrix.python-version == '{% endraw %}{{ py.latest() }}{% raw %}' }}{% endraw %}
      with:
        fail_ci_if_error: true
        use_pypi: true
        version: 11.2.8
{%- endif %}
{%- if enable_docs %}

docs:
  name: Documentation
  runs-on: ubuntu-latest
  timeout-minutes: 15
  steps:
    {{ ci.step_checkout(full_history=true) | indent(4) }}

    {{ ci.steps_project_setup() | indent(4) }}

    - name: 📖 Build documentation
      run: mise run docs-build
{%- endif %}
{{ super() }}
{% endblock %}
