{% extends "common/templates/github-workflow.yaml.jinja" %}
{% import "common/github-workflow-steps.jinja" as ci with context %}
{% import "common/python.jinja" as py with context %}

{% block name -%}
Docs
{%- endblock %}

{% block triggers %}
push:
  branches:
    - main
workflow_dispatch:
{% endblock %}

{% block concurrency_cancel_in_progress -%}
false
{%- endblock %}

{% block jobs %}
build:
  name: Build Documentation
  runs-on: ubuntu-latest
  timeout-minutes: 15
  env:
    UV_PYTHON: '{{ py.latest() }}'
  steps:
    {{ ci.step_checkout(full_history=true) | indent(4) }}

    {{ ci.steps_project_setup() | indent(4) }}

    - name: 📖 Build documentation
      run: mise run docs-build

    - name: 🔼 Upload artifact
      uses: actions/upload-pages-artifact@v5
      with:
        path: site/

deploy:
  name: Deploy Documentation
  needs: build
  runs-on: ubuntu-latest
  timeout-minutes: 15
  environment:
    name: github-pages
    url: {% raw %}${{ steps.deployment.outputs.page_url }}{% endraw %}
  permissions:
    pages: write
    id-token: write
  concurrency:
    group: pages
    cancel-in-progress: false
  steps:
    - name: 🚀 Deploy site
      uses: actions/deploy-pages@v5
      id: deployment
{% endblock %}
{#- vim: set ft=yaml: #}
