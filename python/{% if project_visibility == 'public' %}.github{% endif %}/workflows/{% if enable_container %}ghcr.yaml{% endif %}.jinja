{% extends "common/templates/workflows/base.jinja" %}
{% import "common/github-workflow-steps.jinja" as ci with context %}

{% block name -%}
Container Registry
{%- endblock %}

{% block triggers %}
pull_request:
  types:
    - closed
schedule:
  - cron: 0 3 * * 0
workflow_dispatch:
{% endblock %}

{% block concurrency %}
group: ghcr-cleanup-{% raw %}${{ github.event.pull_request.number || 'scheduled' }}{% endraw %}
cancel-in-progress: false
{% endblock %}

{% block jobs %}
cleanup-pr:
  name: Clean up closed pull request image
  if: github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name == github.repository
  runs-on: ubuntu-latest
  timeout-minutes: 15
  permissions:
    packages: write
  steps:
    - name: 🧹 Clean up pull request image
      uses: dataaxiom/ghcr-cleanup-action@v1
      with:
        token: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
        delete-tags: {% raw %}pr-${{ github.event.pull_request.number }}{% endraw %}

cleanup:
  name: Clean up images
  if: github.event_name != 'pull_request'
  runs-on: ubuntu-latest
  timeout-minutes: 15
  permissions:
    packages: write
  steps:
    - name: 🧹 Delete stray stale images
      uses: dataaxiom/ghcr-cleanup-action@v1
      with:
        token: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
        keep-n-tagged: 0
        use-regex: true
        exclude-tags: ^(\d+|\d+\.\d+|\d+\.\d+\.\d+|latest|edge|{% raw %}${{ github.event.repository.default_branch }}{% endraw %})$
        older-than: 30 days

    - name: 🧹 Delete untagged container images
      uses: dataaxiom/ghcr-cleanup-action@v1
      with:
        token: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
        delete-untagged: true
{% endblock %}
{#- vim: set ft=yaml: #}
