{% extends "common/templates/github_workflow.yaml.jinja" %}
{% import "common/github-workflow-steps.jinja" as ci with context %}
{% import "common/python.jinja" as py with context %}

{% block name -%}
Release
{%- endblock %}

{% block triggers %}
on:
  push:
    tags:
      - v[0-9]*.[0-9]*
{% endblock %}

{% block concurrency_cancel_in_progress -%}
false
{%- endblock %}

{% block jobs %}
build:
  name: Build distribution
  runs-on: ubuntu-latest
  cache-mode: none
  timeout-minutes: 15
  env:
    UV_PYTHON: '{{ py.latest() }}'
  steps:
    {{ ci.step_checkout(full_history=true) | indent(4) }}

    {{ ci.steps_project_setup(cache=false) | indent(4) }}

    - name: 📦 Build package
      run: mise run build

    - name: 🔼 Upload artifact
      uses: actions/upload-artifact@v7
      with:
        if-no-files-found: error
        name: dist
        path: dist/

release:
  name: Create GitHub release
  needs: build
  runs-on: ubuntu-latest
  timeout-minutes: 15
  permissions:
    contents: write
  steps:
    - name: 🔽 Download artifact
      uses: actions/download-artifact@v8
      with:
        name: dist
        path: dist/

    - name: 🏷️ Create GitHub release
      run: gh release create "${REF_NAME}" dist/* --generate-notes
      env:
        GH_REPO: {% raw %}${{ github.repository }}{% endraw %}
        GH_TOKEN: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
        REF_NAME: {% raw %}${{ github.ref_name }}{% endraw %}

publish:
  name: Publish to PyPI
  needs: build
  runs-on: ubuntu-latest
  timeout-minutes: 15
  environment:
    name: pypi
    url: https://pypi.org/project/{{ project_name }}/
  permissions:
    id-token: write
  steps:
    - name: 🔽 Download artifact
      uses: actions/download-artifact@v8
      with:
        name: dist
        path: dist/

    - name: ☢️ Publish to PyPI
      uses: pypa/gh-action-pypi-publish@release/v1
      with:
        attestations: true
{% endblock %}
{#- vim: set ft=yaml: #}
