{% extends "common/templates/github_workflow.yaml.jinja" %}
{% import "common/github-workflow-steps.jinja" as ci with context %}
{% import "common/python.jinja" as py with context %}

{% block name -%}
Audit
{%- endblock %}

{% block triggers %}
on:
  push:
    branches:
      - main
    paths:
      - uv.lock
  pull_request:
    paths:
      - uv.lock
{% endblock %}

{% block jobs %}
audit:
  name: Dependencies
  runs-on: ubuntu-latest
  timeout-minutes: 15
  env:
    UV_PYTHON: '{{ py.latest() }}'
  steps:
    {{ ci.step_checkout() | indent(4) }}

    {{ ci.steps_project_setup() | indent(4) }}

    - name: 🔍 Check dependencies
      run: mise run audit
{% endblock %}
