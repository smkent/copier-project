{% extends "common/templates/workflows/base.jinja" %}
{% import "common/github-workflow-steps.jinja" as ci with context %}
{% import "common/python.jinja" as py with context %}

{% block name -%}
Audit
{%- endblock %}

{% block triggers %}
{%- set paths = ['pyproject.toml', 'uv.lock'] -%}
push:
  branches:
    - main
  paths:
{%- for path in paths %}
    - {{ path }}
{%- endfor %}
pull_request:
  paths:
{%- for path in paths %}
    - {{ path }}
{%- endfor %}
{% endblock %}

{% block env %}
{{ py.workflow_env() }}
{% endblock %}

{% block jobs %}
audit:
  name: Dependencies
  runs-on: ubuntu-latest
  timeout-minutes: 15
  steps:
    {{ ci.step_checkout() | indent(4) }}

    {{ ci.steps_project_setup() | indent(4) }}

    - name: 🔍 Check dependencies
      run: mise run audit
{% endblock %}
