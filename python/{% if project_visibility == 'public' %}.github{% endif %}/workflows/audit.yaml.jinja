{%- import "common/python.jinja" as py with context -%}
name: Audit

on:
  push:
    branches:
      - main
    paths:
      - uv.lock
  pull_request:
    paths:
      - uv.lock

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.head_ref || github.ref }}{% endraw %}
  cancel-in-progress: {% raw %}${{ github.event_name == 'pull_request' }}{% endraw %}

permissions:
  contents: read

jobs:
  audit:
    name: Dependencies
    runs-on: ubuntu-latest
    timeout-minutes: 15
    env:
      UV_PYTHON: '{{ py.latest() }}'
    steps:
      - name: 💾 Check out repository
        uses: actions/checkout@v7
        with:
          persist-credentials: false

      - name: 📦 Cache uv managed packages
        uses: actions/cache@v6
        with:
          path: ~/.cache/uv
          key: {% raw %}uv-${{ runner.os }}-${{ hashFiles('pyproject.toml', 'uv.lock') }}{% endraw %}
          restore-keys: |
            {% raw %}uv-${{ runner.os }}-{% endraw %}

      - name: 🍳 Set up mise
        uses: jdx/mise-action@v5
        with:
          cache: true
          install: true

      - name: 🔍 Check dependencies
        run: mise run audit
{#- vim: set ft=yaml: #}
