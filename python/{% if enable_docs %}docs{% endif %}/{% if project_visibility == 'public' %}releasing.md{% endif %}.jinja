{% extends "common/templates/docs/releasing.md.jinja" %}

{% set urls = {} %}

{% block release_effects -%}
* A release package is built.
{% if enable_pypi -%}
{% set _urls = urls.update({
    "pypi-badge": "https://img.shields.io/pypi/v/" + project_name,
    "pypi-project": "https://pypi.org/project/" + project_name + "/",
}) -%}

* The release package is [uploaded to PyPI][pypi-project].

    [![PyPI][pypi-badge]][pypi-project]

{% endif -%}
{{ super() }}
{%- if enable_container %}
{%- set _urls = urls.update({
    "ghcr-docs": "https://docs.github.com/en/packages/working-with-a-github-packages-registry/working-with-the-container-registry",
}) %}

* A container image is built and published to the
  [GitHub Container Registry (GHCR)][ghcr-docs].
{%- endif %}
{%- endblock %}
