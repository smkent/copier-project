{%- import "common/license.jinja" as license with context -%}
{%- import "common/python.jinja" as py with context -%}
{%- set uv_sync -%}
uv sync{% if project_type == "application" %} --locked{% endif %} --no-default-groups
{%- endset -%}
FROM python:{{ py.latest() }}-slim AS builder

COPY --from=ghcr.io/astral-sh/uv /uv /uvx /bin/

WORKDIR /app

# Install dependencies
COPY pyproject.toml{% if project_type == "application" %} uv.lock{% endif %} .
RUN --mount=type=cache,target=/root/.cache/uv \
    {{ uv_sync }} --no-install-project

# Install project
COPY README.md {{ license.files | join(' ') }} .
COPY {{ project_slug }}/ ./{{ project_slug }}/
ARG UV_DYNAMIC_VERSIONING_BYPASS=0.0.0
RUN {{ uv_sync }} --no-editable

FROM python:{{ py.latest() }}-slim

LABEL org.opencontainers.image.licenses="{{ copyright_license }}"

COPY --from=builder /app/.venv /app/.venv

RUN useradd --no-create-home --shell /bin/false app
USER app

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1

CMD ["python", "-m", "{{ project_slug }}"]
{#- vim: set ft=dockerfile: #}
