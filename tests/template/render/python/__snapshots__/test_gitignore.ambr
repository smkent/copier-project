# serializer version: 1
# name: test_gitignore[enable_docs-private-application]
  '''
  # Python
  __pycache__/
  *.egg-info/
  *.py[cod]
  
  # uv and packaging
  .venv*/
  /build/
  /dist/
  
  # mise
  mise.local.toml
  .mise.local.toml
  
  # Development tools
  .cache/
  .coverage*
  .pytest_cache/
  .ruff_cache/
  /htmlcov/
  /site/
  coverage.xml
  
  '''
# ---
