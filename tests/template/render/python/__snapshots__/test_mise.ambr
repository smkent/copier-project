  raw_args = true
  run = "betterleaks git . --redact"
  
  [tasks.snapup]
  description = "Update test snapshots"
  raw_args = true
  run = "uv run pytest --snapshot-update"
  
  [tasks.test]
  description = "Run tests"
  raw_args = true
  run = "uv run pytest"
  
  [tasks.test-versions]
  description = "Run tests across all Python versions"
  run = [
    { task = "test-py311" },
