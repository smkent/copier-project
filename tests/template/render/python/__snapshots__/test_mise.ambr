  betterleaks = "latest"
  jactionlint = "latest"
  "pipx:copier" = "latest"
  prek = "latest"
  taplo = "latest"
  uv = "latest"
  
  [tasks.build]
  description = "Build distribution package"
  raw_args = true
  run = "uv build"
  
  [tasks.lint]
  description = "Run all formatters and static checks"
  raw_args = true
  run = "prek run --all-files"
  
  [tasks.lt]
  description = "Run all formatters, static checks and tests"
  run = [{ task = "lint" }, { task = "test" }]
  
  [tasks.release]
  description = "Create and push a release tag (patch/minor/major)"
  raw_args = true
  run = "uv run bump-my-version bump -v"
  
  [tasks.secretscan]
  description = "Scan git history for secrets"
  raw_args = true
  run = "betterleaks git . --redact"
  
  [tasks.test]
  description = "Run tests"
  raw_args = true
  run = "uv run pytest"
  
  [tasks.test-versions]
  description = "Run tests across all Python versions"
  run = [
    { task = "test-py311" },
    { task = "test-py312" },
    { task = "test-py313" },
    { task = "test-py314" },
    { task = "test-py315" },
