# serializer version: 1
# name: test_mise_config[no_xdist-no_syrupy-docs-private-accepted-with-disclosure]
  '''
  min_version = "2026.2.5"
  
  [hooks]
  postinstall = [
    "uv sync",
    "[ -e .git ] && prek --quiet install || { echo \"No git repository found.\"; }",
  ]
  
  [tools]
  betterleaks = "latest"
  jactionlint = "latest"
  "pipx:copier" = "latest"
  prek = "latest"
  taplo = "latest"
  uv = "latest"
  
  [tasks.build]
  description = "Build distribution package"
  raw_args = true
  run = "uv build"
  
  [tasks.docs]
  description = "Run documentation site locally"
  depends = ["docs-build"]
  run = 'uv run zensical serve -a "${usage_host:-localhost}:${usage_port:-8000}"'
  usage = '''
  flag "--host <host>" help="Bind IP" default="localhost"
  arg "[port]" help="Bind port" default="8000"
  '''
  
  [tasks.docs-build]
  description = "Build documentation site"
  raw_args = true
  run = "uv run zensical build -c"
  
  [tasks.lint]
  description = "Run all formatters and static checks"
  raw_args = true
  run = "prek run --all-files"
  
  [tasks.lt]
  description = "Run all formatters, static checks and tests"
  run = [{ task = "lint" }, { task = "test" }]
  
  [tasks.release]
  description = "Create and push a release tag (patch/minor/major)"
  raw_args = true
  run = "uv run bump-my-version bump -v"
  
  [tasks.secretscan]
  description = "Scan git history for secrets"
  raw_args = true
  run = "betterleaks git . --redact"
  
  [tasks.test]
  description = "Run tests"
  raw_args = true
  run = "uv run pytest"
  
  [tasks.test-versions]
  description = "Run tests across all Python versions"
  run = [
    { task = "test-py311" },
    { task = "test-py312" },
    { task = "test-py313" },
    { task = "test-py314" },
    { task = "test-py315" },
  ]
  
  [tasks.test-py311]
  description = "Run tests using Python 3.11"
  env = { UV_PROJECT_ENVIRONMENT = ".venv-py311" }
  raw_args = true
  run = "uv run --python 3.11 pytest"
  
  [tasks.test-py312]
  description = "Run tests using Python 3.12"
  env = { UV_PROJECT_ENVIRONMENT = ".venv-py312" }
  raw_args = true
  run = "uv run --python 3.12 pytest"
  
  [tasks.test-py313]
  description = "Run tests using Python 3.13"
  env = { UV_PROJECT_ENVIRONMENT = ".venv-py313" }
  raw_args = true
  run = "uv run --python 3.13 pytest"
  
  [tasks.test-py314]
  description = "Run tests using Python 3.14"
  env = { UV_PROJECT_ENVIRONMENT = ".venv-py314" }
  raw_args = true
  run = "uv run --python 3.14 pytest"
  
  [tasks.test-py315]
  description = "Run tests using Python 3.15"
  env = { UV_PROJECT_ENVIRONMENT = ".venv-py315" }
  raw_args = true
  run = "uv run --python 3.15 pytest"
  
  [tasks.ti]
  description = "Run tests with debug friendly options"
  raw_args = true
  run = "uv run pytest --no-cov -vv"
  
  '''
# ---
# name: test_mise_config[no_xdist-no_syrupy-docs-private-accepted-with-disclosure].1
  '''
  [tasks.init]
  description = "Initialize git repository once on project creation"
  run = [
    '[ ! -d .git ] || { echo "git repository already exists"; exit 1; }',
    "git init",
    "mise install",
    "git add .",
    "git rm -f .mise/conf.d/init.toml",
    "git commit -m 'Create project from template'",
  ]
  
  '''
# ---
