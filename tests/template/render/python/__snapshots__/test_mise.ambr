  raw_args = true
  run = "uv run --python 3.14 pytest"
  
  [tasks.test-py315]
  description = "Run tests using Python 3.15"
  env = { UV_PROJECT_ENVIRONMENT = ".venv-py315" }
  raw_args = true
  run = "uv run --python 3.15 pytest"
  
  [tasks.ti]
  description = "Run tests with debug friendly options"
  raw_args = true
  run = "uv run pytest --no-cov -vv"
  
