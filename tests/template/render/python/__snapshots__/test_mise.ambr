  betterleaks = "latest"
  jactionlint = "latest"
  "pipx:copier" = "latest"
  prek = "latest"
  taplo = "latest"
  uv = "latest"
  
  [tasks.build]
  description = "Build distribution package"
  raw_args = true
  run = "uv build"
  
  [tasks.docs]
  description = "Run documentation site locally"
  depends = ["docs-build"]
  run = 'uv run zensical serve -a "${usage_host:-localhost}:${usage_port:-8000}"'
  usage = '''
  flag "--host <host>" help="Bind IP" default="localhost"
  arg "[port]" help="Bind port" default="8000"
  '''
  
  [tasks.docs-build]
  description = "Build documentation site"
  raw_args = true
  run = "uv run zensical build -c"
  
  [tasks.lint]
  description = "Run all formatters and static checks"
  raw_args = true
  run = "prek run --all-files"
  
  [tasks.lt]
  description = "Run all formatters, static checks and tests"
  run = [{ task = "lint" }, { task = "test" }]
  
  [tasks.release]
  description = "Create and push a release tag (patch/minor/major)"
  raw_args = true
  run = "uv run bump-my-version bump -v"
  
  [tasks.secretscan]
  description = "Scan git history for secrets"
  raw_args = true
  run = "betterleaks git . --redact"
  
  [tasks.snapup]
  description = "Update test snapshots"
  raw_args = true
  run = "uv run pytest --snapshot-update --numprocesses 0"
  
  [tasks.test]
  description = "Run tests"
  raw_args = true
  run = "uv run pytest"
  
  [tasks.test-versions]
  description = "Run tests across all Python versions"
  run = [
