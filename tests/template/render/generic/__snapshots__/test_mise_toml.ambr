# ---
# name: test_mise_toml[public-accepted-with-disclosure]
  '''
  min_version = "2026.2.5"
  
  [hooks]
  postinstall = [
    "[ -e .git ] && prek --quiet install || { echo \"No git repository found. If this is a new project, run \\`mise run init\\` to create it.\"; }",
  ]
  
  [tools]
  betterleaks = "latest"
  jactionlint = "latest"
  "pipx:commit-check" = "latest"
  "pipx:copier" = "latest"
  prek = "latest"
  taplo = "latest"
  uv = "latest"
  
  [tasks.init]
  description = "Initialize git repository once on project creation"
  run = [
    '[ ! -d .git ] || { echo "git repository already exists"; exit 1; }',
    "git init",
    "mise install",
    "git remote add origin https://github.com/ness/PKFire",
    "git config --local remote.origin.pushurl git@github.com:ness/PKFire.git",
    "git add .",
    "git commit -m 'Create project from template'",
  ]
  
  [tasks.lint]
  description = "Run all formatters and static checks"
  raw_args = true
  run = "prek run --all-files"
  
  [tasks.lt]
  description = "Run all formatters and static checks (same as lint)"
  run = [{ task = "lint" }]
  
  [tasks.secretscan]
  description = "Scan git history for secrets"
  raw_args = true
  run = "betterleaks git . --redact"
  
  '''
