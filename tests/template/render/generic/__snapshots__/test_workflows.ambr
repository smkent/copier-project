# serializer version: 1
# name: test_workflows_ci[accepted-with-disclosure]
  '''
  name: CI
  
  on:
    push:
      branches:
        - main
    pull_request:
  
  permissions:
    contents: read
  
  concurrency:
    group: ${{ github.workflow }}-${{ github.head_ref || github.ref }}
    cancel-in-progress: ${{ github.event_name == 'pull_request' }}
  
  jobs:
    ci:
      name: Test
      runs-on: ubuntu-latest
      timeout-minutes: 15
      steps:
        - name: 💾 Check out repository
          uses: actions/checkout@v7
          with:
            persist-credentials: false
  
        - name: 🍳 Set up mise
          uses: jdx/mise-action@v5
          with:
            cache: true
            install: true
  
        - name: 📐 Lint
          run: mise run lint
  
        - name: 🔥 Test
          run: mise run test
  
    docs:
      name: Documentation
      runs-on: ubuntu-latest
      timeout-minutes: 15
      steps:
        - name: 💾 Check out repository
          uses: actions/checkout@v7
          with:
            fetch-depth: 0
            persist-credentials: false
  
        - name: 🍳 Set up mise
          uses: jdx/mise-action@v5
          with:
            cache: true
            install: true
  
        - name: 📖 Build documentation
          run: mise run docs-build
  
    betterleaks:
      name: Secret scan
      runs-on: ubuntu-latest
      timeout-minutes: 15
      steps:
        - name: 💾 Check out repository
          uses: actions/checkout@v7
          with:
            fetch-depth: 0
            persist-credentials: false
  
        - name: 🍳 Set up mise
          uses: jdx/mise-action@v5
          with:
            cache: true
            install: true
  
        - name: 🔍 Check for secrets
          run: mise run secretscan
  
    commit-messages:
      name: Commit messages
      if: ${{ github.event_name == 'pull_request' }}
      runs-on: ubuntu-latest
      timeout-minutes: 15
      steps:
        - name: 💾 Check out repository
          uses: actions/checkout@v7
          with:
            fetch-depth: 0
            persist-credentials: false
  
        - name: ✉️ Check commit messages
          uses: commit-check/commit-check-action@v2
          with:
            branch: false
  
  '''
