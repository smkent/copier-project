{% extends "common/templates/ci.yaml.jinja" %}
{% import "common/github-workflow-steps.jinja" as ci with context %}

{% block jobs %}
ci:
  name: Lint
  runs-on: ubuntu-latest
  timeout-minutes: 15
  steps:
    {{ ci.step_checkout() | indent(4) }}

    {{ ci.steps_project_setup() | indent(4) }}

    - name: 📐 Lint
      run: mise run lint

    - name: 🔥 Test
      run: mise run test
{{ super() }}
{% endblock %}
